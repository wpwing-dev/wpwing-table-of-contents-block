#. Plugin Name of the plugin
#: wpwing-table-of-contents-block.php
msgid "Table of Contents (TOC) Block - Fast & SEO Friendly"
msgstr "Bloque de Tabla de Contenidos (TOC) - Rápido y Optimizado para SEO"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: wpwing-table-of-contents-block.php
msgid "https://wpwing.com/"
msgstr "https://wpwing.com/"

#. Description of the plugin
#: wpwing-table-of-contents-block.php
msgid "Automated, ultra-fast Table of Contents block built to boost SEO and readability with zero frontend JavaScript."
msgstr "Bloque de tabla de contenidos automatizado y ultrarrápido diseñado para mejorar el SEO y la legibilidad sin JavaScript en el frontend."

#. Author of the plugin
#: wpwing-table-of-contents-block.php
#: wpwing-table-of-contents-block.php:277
#: wpwing-table-of-contents-block.php:278
msgid "WPWing"
msgstr "WPWing"

#: wpwing-table-of-contents-block.php:56
msgid "Support"
msgstr "Soporte"

#: wpwing-table-of-contents-block.php:57
msgid "Write a review"
msgstr "Escribir una reseña"

#: wpwing-table-of-contents-block.php:58
msgid "Documentation"
msgstr "Documentación"

#: wpwing-table-of-contents-block.php:66
msgid "Settings"
msgstr "Ajustes"

#: wpwing-table-of-contents-block.php:244
msgid "You are not allowed to do this."
msgstr "No tienes permisos para hacer esto."

#: wpwing-table-of-contents-block.php:290
#: wpwing-table-of-contents-block.php:326
msgid "Table of Contents Block"
msgstr "Bloque de Tabla de Contenidos"

#: wpwing-table-of-contents-block.php:291
msgid "TOC Block"
msgstr "Bloque TOC"

#: wpwing-table-of-contents-block.php:320
msgid "Before the first heading"
msgstr "Antes del primer encabezado"

#: wpwing-table-of-contents-block.php:321
msgid "After the first paragraph"
msgstr "Después del primer párrafo"

#: wpwing-table-of-contents-block.php:322
msgid "Top of the content"
msgstr "Al principio del contenido"

#: wpwing-table-of-contents-block.php:329
msgid "Settings imported from LuckyWP Table of Contents."
msgstr "Ajustes importados desde LuckyWP Table of Contents."

#: wpwing-table-of-contents-block.php:331
msgid "No LuckyWP Table of Contents settings were found to import."
msgstr "No se encontraron ajustes de LuckyWP Table of Contents para importar."

#: wpwing-table-of-contents-block.php:335
msgid "Import settings"
msgstr "Importar ajustes"

#: wpwing-table-of-contents-block.php:336
msgid "LuckyWP Table of Contents settings were found on this site. Import its list style, title, minimum-headings threshold, and smooth-scroll settings into the defaults below."
msgstr "Se encontraron ajustes de LuckyWP Table of Contents en este sitio. Importa su estilo de lista, título, umbral de encabezados mínimos y desplazamiento suave a los valores predeterminados a continuación."

#: wpwing-table-of-contents-block.php:340
msgid "Import from LuckyWP Table of Contents"
msgstr "Importar desde LuckyWP Table of Contents"

#: wpwing-table-of-contents-block.php:345
msgid "Auto-insert"
msgstr "Inserción automática"

#: wpwing-table-of-contents-block.php:346
msgid "Show a Table of Contents automatically, without adding the block to each post. Posts that already contain a TOC block keep their own block and are skipped."
msgstr "Muestra una tabla de contenidos automáticamente, sin añadir el bloque a cada entrada. Las entradas que ya contienen un bloque TOC conservan su propio bloque y se omiten."

#: wpwing-table-of-contents-block.php:349
msgid "Enable for post types"
msgstr "Activar para tipos de contenido"

#: wpwing-table-of-contents-block.php:358
msgid "No post type checked means auto-insert is off."
msgstr "Si no hay ningún tipo de contenido marcado, la inserción automática está desactivada."

#: wpwing-table-of-contents-block.php:363
msgid "Position"
msgstr "Posición"

#: wpwing-table-of-contents-block.php:373
msgid "Minimum headings"
msgstr "Encabezados mínimos"

#: wpwing-table-of-contents-block.php:376
msgid "Skip posts with fewer qualifying headings, so short posts stay clean."
msgstr "Omite entradas con menos encabezados válidos, para que las entradas cortas se mantengan limpias."

#: wpwing-table-of-contents-block.php:380
msgid "New block defaults"
msgstr "Valores por defecto para nuevos bloques"

#: wpwing-table-of-contents-block.php:383
msgid "Custom title"
msgstr "Título personalizado"

#: wpwing-table-of-contents-block.php:387
msgid "Minimum and maximum levels"
msgstr "Niveles mínimo y máximo"

#: wpwing-table-of-contents-block.php:394
msgid "Collapsible mode"
msgstr "Modo plegable"

#: wpwing-table-of-contents-block.php:396
msgid "Make new blocks collapsible"
msgstr "Hacer que los nuevos bloques sean plegables"

