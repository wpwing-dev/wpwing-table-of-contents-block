#. Plugin Name of the plugin
#: wpwing-table-of-contents-block.php
msgid "Table of Contents (TOC) Block - Fast & SEO Friendly"
msgstr "Bloco de Sumário (TOC) - Rápido e Otimizado para SEO"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: wpwing-table-of-contents-block.php
msgid "https://wpwing.com/"
msgstr "https://wpwing.com/"

#. Description of the plugin
#: wpwing-table-of-contents-block.php
msgid "Automated, ultra-fast Table of Contents block built to boost SEO and readability with zero frontend JavaScript."
msgstr "Bloco de sumário automatizado e ultrarrápido criado para melhorar o SEO e a legibilidade com zero JavaScript no frontend."

#. Author of the plugin
