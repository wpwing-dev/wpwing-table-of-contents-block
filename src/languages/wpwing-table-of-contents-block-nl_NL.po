#. Plugin Name of the plugin
#: wpwing-table-of-contents-block.php
msgid "Table of Contents (TOC) Block - Fast & SEO Friendly"
msgstr "Inhoudsopgave (TOC) Blok - Snel & SEO-vriendelijk"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: wpwing-table-of-contents-block.php
msgid "https://wpwing.com/"
msgstr "https://wpwing.com/"

#. Description of the plugin
#: wpwing-table-of-contents-block.php
msgid "Automated, ultra-fast Table of Contents block built to boost SEO and readability with zero frontend JavaScript."
msgstr "Geautomatiseerd, ultrasnel inhoudsopgaveblok gebouwd om SEO en leesbaarheid te verbeteren zonder JavaScript aan de voorkant."

#. Author of the plugin
#: wpwing-table-of-contents-block.php
#: wpwing-table-of-contents-block.php:277
#: wpwing-table-of-contents-block.php:278
msgid "WPWing"
msgstr "WPWing"

