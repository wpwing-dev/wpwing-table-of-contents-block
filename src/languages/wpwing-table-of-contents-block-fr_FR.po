#. Plugin Name of the plugin
#: wpwing-table-of-contents-block.php
msgid "Table of Contents (TOC) Block - Fast & SEO Friendly"
msgstr "Bloc Table des Matières (TOC) - Rapide & Optimisé pour le SEO"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: wpwing-table-of-contents-block.php
msgid "https://wpwing.com/"
msgstr "https://wpwing.com/"

#. Description of the plugin
#: wpwing-table-of-contents-block.php
msgid "Automated, ultra-fast Table of Contents block built to boost SEO and readability with zero frontend JavaScript."
msgstr "Bloc table des matières automatisé et ultrarapide conçu pour améliorer le SEO et la lisibilité sans aucun JavaScript frontend."

