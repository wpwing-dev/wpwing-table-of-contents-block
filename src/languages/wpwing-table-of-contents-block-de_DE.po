#. Plugin Name of the plugin
#: wpwing-table-of-contents-block.php
msgid "Table of Contents (TOC) Block - Fast & SEO Friendly"
msgstr "Inhaltsverzeichnis (TOC) Block - Schnell & SEO-freundlich"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: wpwing-table-of-contents-block.php
msgid "https://wpwing.com/"
msgstr "https://wpwing.com/"

#. Description of the plugin
#: wpwing-table-of-contents-block.php
msgid "Automated, ultra-fast Table of Contents block built to boost SEO and readability with zero frontend JavaScript."
msgstr "Automatisierter, ultraschneller Inhaltsverzeichnis-Block zur Steigerung von SEO und Lesbarkeit mit null Frontend-JavaScript."

#. Author of the plugin
