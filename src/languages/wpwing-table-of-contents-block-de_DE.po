msgid "Remove nested indentation"
msgstr "Verschachtelte Einrückung entfernen"

#: wpwing-table-of-contents-block.php:435
msgid "Thresholds and filtering"
msgstr "Schwellenwerte und Filterung"

#: wpwing-table-of-contents-block.php:438
#: assets/public/index.js:1
#: assets/src/edit.js:153
msgid "Minimum headings to show TOC"
msgstr "Mindestanzahl Überschriften für Inhaltsverzeichnis"

#: wpwing-table-of-contents-block.php:442
msgid "Exclude headings containing"
msgstr "Überschriften ausschließen mit"

#: wpwing-table-of-contents-block.php:445
msgid "Comma-separated keywords. Headings containing any of them are skipped."
msgstr "Kommagetrennte Schlüsselwörter. Überschriften, die eines davon enthalten, werden übersprungen."

#: wpwing-table-of-contents-block.php:450
msgid "Links"
msgstr "Links"

#: wpwing-table-of-contents-block.php:453
#: wpwing-table-of-contents-block.php:879
#: wpwing-table-of-contents-block.php:1144
msgid "Back to top"
msgstr "Nach oben"

#: wpwing-table-of-contents-block.php:455
msgid "Show a back-to-top link below the TOC"
msgstr "Einen „Nach oben“-Link unter dem Inhaltsverzeichnis anzeigen"

#: wpwing-table-of-contents-block.php:456
msgid "Add a back-to-top link after each heading"
msgstr "Einen „Nach oben“-Link nach jeder Überschrift einfügen"

#: wpwing-table-of-contents-block.php:460
msgid "Copy link"
msgstr "Link kopieren"

#: wpwing-table-of-contents-block.php:461
msgid "Show a copy-link button on each entry"
msgstr "Einen Button zum Kopieren des Links bei jedem Eintrag anzeigen"

#: wpwing-table-of-contents-block.php:464
msgid "URL format"
msgstr "URL-Format"

#: wpwing-table-of-contents-block.php:465
msgid "Use absolute URLs in TOC links"
msgstr "Absolute URLs in Inhaltsverzeichnis-Links verwenden"

#: wpwing-table-of-contents-block.php:469
msgid "Scrolling"
msgstr "Scrollen"

#: wpwing-table-of-contents-block.php:472
msgid "Smooth scroll"
msgstr "Sanftes Scrollen"

#: wpwing-table-of-contents-block.php:473
msgid "Enable smooth scrolling to headings"
msgstr "Sanftes Scrollen zu Überschriften aktivieren"

#: wpwing-table-of-contents-block.php:476
msgid "Scroll offset"
msgstr "Scroll-Versatz"

#: wpwing-table-of-contents-block.php:478
msgid "px"
msgstr "px"

#: wpwing-table-of-contents-block.php:479
msgid "Keeps headings visible below sticky or fixed headers when jumping from the TOC."
msgstr "Hält Überschriften unter fixierten Kopfzeilen sichtbar, wenn aus dem Inhaltsverzeichnis gesprungen wird."

#: wpwing-table-of-contents-block.php:484
msgid "Accessibility and SEO"
msgstr "Barrierefreiheit und SEO"

#: wpwing-table-of-contents-block.php:487
msgid "Title and count"
msgstr "Titel und Anzahl"

#: wpwing-table-of-contents-block.php:489
msgid "Hide the TOC title"
msgstr "Titel des Inhaltsverzeichnisses ausblenden"

#: wpwing-table-of-contents-block.php:490
msgid "Show a heading-count badge next to the title"
msgstr "Badge mit Anzahl der Überschriften neben dem Titel anzeigen"

#: wpwing-table-of-contents-block.php:494
msgid "Search snippets"
msgstr "Such-Snippets"

#: wpwing-table-of-contents-block.php:495
msgid "Exclude TOC text from search result snippets"
msgstr "Text des Inhaltsverzeichnisses von Suchergebnis-Snippets ausschließen"

#: wpwing-table-of-contents-block.php:521
#: wpwing-table-of-contents-block.php:1090
msgid "Table of Contents"
msgstr "Inhaltsverzeichnis"

#: wpwing-table-of-contents-block.php:530
msgid "No content found. Save or update the post first."
msgstr "Kein Inhalt gefunden. Bitte speichern oder aktualisieren Sie zuerst den Beitrag."

#: wpwing-table-of-contents-block.php:550
msgid "Add Heading blocks to your post and the TOC will appear here."
msgstr "Fügen Sie Ihrem Beitrag Überschrift-Blöcke hinzu und das Inhaltsverzeichnis erscheint hier."

#. translators: 1: current heading count, 2: required minimum
#: wpwing-table-of-contents-block.php:570
#, php-format
msgid "TOC hidden: %1$d qualifying heading(s) found, minimum required is %2$d."
msgstr "Inhaltsverzeichnis ausgeblendet: %1$d passende Überschrift(en) gefunden, mindestens erforderlich sind %2$d."

#: wpwing-table-of-contents-block.php:1076
msgid "Copy link to this section"
msgstr "Link zu diesem Abschnitt kopieren"

